<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:st="http://zujevas.com/xml/steam"
    targetNamespace="http://zujevas.com/xml/steam"
    elementFormDefault="qualified" 
    attributeFormDefault="unqualified">

    <!-- 1. paprasti tipai su apribojimais -->

    <xs:simpleType name="PriceType">
        <xs:restriction base="xs:decimal">
            <xs:minInclusive value="0"/>
            <xs:totalDigits value="8"/>
            <xs:fractionDigits value="2"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="GameIdType">
        <xs:restriction base="xs:string">
            <xs:pattern value="gm_[0-9]{4}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="DlcIdType">
        <xs:restriction base="xs:string">
            <xs:pattern value="dlc_[0-9]{4}_[0-9]{2}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="GenreIdType">
        <xs:restriction base="xs:string">
            <xs:pattern value="g_[a-z]+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="CurrencyType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="EUR"/>
            <xs:enumeration value="USD"/>
            <xs:enumeration value="GBP"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- 2. prasmingas sąrašo tipas -->

    <xs:simpleType name="PlatformType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Windows"/>
            <xs:enumeration value="macOS"/>
            <xs:enumeration value="Linux"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="PlatformListType">
        <xs:restriction>
            <xs:simpleType>
                <xs:list itemType="st:PlatformType"/>
            </xs:simpleType>
            <xs:minLength value="1"/>
            <xs:maxLength value="3"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- 3. sudėtingi tipai su paprastu turiniu -->

    <!-- bazinis tipas - žaidimo kaina su valiuta -->
    <xs:complexType name="GamePriceType">
        <xs:simpleContent>
            <xs:extension base="st:PriceType">
                <xs:attribute name="currency" type="st:CurrencyType" use="required"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>    

    <!-- apribojimas, mažiau leidžiamų reikšmių -->
    <xs:complexType name="IndiePriceType">
        <xs:simpleContent>
            <xs:restriction base="st:GamePriceType">
                <xs:maxInclusive value="29.99"/>
            </xs:restriction>
        </xs:simpleContent>
    </xs:complexType>

    <!-- praplėtimas, daugiau atributų -->
    <xs:complexType name="DiscountedPriceType">
        <xs:simpleContent>
            <xs:extension base="st:GamePriceType">
                <xs:attribute name="discountPercent" type="xs:positiveInteger"/>
                <xs:attribute name="saleEnds" type="xs:date"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- 4. sudėtingi tipai su sudėtingu turiniu -->

    <!-- bazinis tipas - produktas -->
    <xs:complexType name="ProductType">
        <xs:sequence>
            <xs:element name="Title" type="xs:string"/>
            <xs:element name="ReleaseDate" type="xs:date"/>
            <xs:choice> <!-- 7. choice valdymo struktūra -->
                <xs:element name="Price" type="st:GamePriceType"/>
                <xs:element name="FreeToPlay">
                    <xs:complexType/>
                </xs:element>
            </xs:choice>
        </xs:sequence>
    </xs:complexType>

    <!-- prapletimas - DLC -->
    <xs:complexType name="DlcType">
        <xs:complexContent>
            <xs:extension base="st:ProductType">
                <xs:attribute name="id" type="st:DlcIdType" use="required"/>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="SecondaryGenresType">
        <xs:sequence>
            <xs:element name="GenreRef" maxOccurs="unbounded">
                <xs:complexType>
                    <xs:attribute name="ref" type="st:GenreIdType" use="required"/>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- prapletimas - Game -->
    <xs:complexType name="GameType">
        <xs:complexContent>
            <xs:extension base="st:ProductType">
                <xs:sequence>
                    <xs:element name="PeakConcurrentPlayers" type="xs:nonNegativeInteger"/>
                    <xs:element name="Description" type="st:DescriptionType"/>
                    <xs:element name="SecondaryGenres" type="st:SecondaryGenresType" minOccurs="0"/>
                    <xs:element name="DLC" type="st:DlcType" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
                <xs:attribute name="id" type="st:GameIdType" use="required"/>
                <xs:attribute name="platforms" type="st:PlatformListType"/>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <!-- apribojimas - bent 1 DLC zaidime -->
    <xs:complexType name="ExpandedGameType">
        <xs:complexContent>
            <xs:restriction base="st:GameType">
            <xs:sequence>
                <xs:element name="Title" type="xs:string"/>
                <xs:element name="ReleaseDate" type="xs:date"/>
                <xs:choice>
                    <xs:element name="Price" type="st:GamePriceType"/>
                    <xs:element name="FreeToPlay">
                        <xs:complexType/>
                    </xs:element>
                </xs:choice>
                <xs:element name="PeakConcurrentPlayers" type="xs:nonNegativeInteger"/>
                <xs:element name="Description" type="st:DescriptionType"/>
                <xs:element name="SecondaryGenres" type="st:SecondaryGenresType" minOccurs="0"/>
                <xs:element name="DLC" type="st:DlcType" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
            </xs:restriction>
        </xs:complexContent>
    </xs:complexType>

    <!-- 6. sudėtingas tipas su mišriu turiniu -->
    <xs:complexType name="DescriptionType" mixed="true">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="b" type="xs:string"/>
            <xs:element name="i" type="xs:string"/>
        </xs:choice>
    </xs:complexType>

    <xs:complexType name="GenreType">
        <xs:sequence>
            <xs:element name="Game" type="st:GameType" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="id" type="st:GenreIdType" use="required"/>
    </xs:complexType>

    <xs:element name="Steam">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Genre" type="st:GenreType" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>

        <!-- 8. Bent viena nuoroda (keyref) į unikalumo ribojimą (unique) arba raktą (key) -->
        <!-- kiekvienas Genre turi turėti unikalų id -->
        <xs:key name="GenreKey">
            <xs:selector xpath="st:Genre" />
            <xs:field xpath="@id" />
        </xs:key>

        <!-- kiekvienas antrinis žanras turi referuoti į egzistuojantį žanrą -->
        <xs:keyref name="GenreRefKeyref" refer="st:GenreKey">
            <xs:selector xpath="st:Genre/st:Game/st:SecondaryGenres/st:GenreRef"/>
            <xs:field xpath="@ref"/>
        </xs:keyref>
    </xs:element>
</xs:schema>
